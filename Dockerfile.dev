# Development image. Unlike the production Dockerfile it installs dev
# dependencies, keeps the sources bind-mounted, and runs the server and the Vite
# dev server with hot reload instead of building a static bundle.

FROM oven/bun:1.4.0-alpine

WORKDIR /app

# git is occasionally needed by dependency installs; curl is used by healthchecks.
# nodejs runs the Vite dev server: Bun's node:http client never emits `upgrade`,
# so Vite's WebSocket proxy cannot forward /api/*/live under Bun.
RUN apk add --no-cache git curl nodejs

# Deliberately no `bun install` here. docker-compose.dev.yml mounts named
# volumes over every node_modules directory and fills them from the lockfile on
# each boot, so anything installed into the image would be shadowed and never
# used — two sources of truth with the stale one winning. The sources are
# bind-mounted over this COPY in development; it exists so the image is still
# runnable on its own.
COPY . .

EXPOSE 3000 1420

CMD ["bun", "run", "dev"]
