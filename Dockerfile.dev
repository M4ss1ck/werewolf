# Development image. Unlike the production Dockerfile it installs dev
# dependencies, keeps the sources bind-mounted, and runs the server and the Vite
# dev server with hot reload instead of building a static bundle.

FROM oven/bun:1.3-alpine

WORKDIR /app

# git is occasionally needed by dependency installs; curl is used by healthchecks.
# nodejs runs the Vite dev server: Bun's node:http client never emits `upgrade`,
# so Vite's WebSocket proxy cannot forward /api/*/live under Bun.
RUN apk add --no-cache git curl nodejs

# Dependencies are installed into the image so a bind mount of the source does
# not drag node_modules across the host boundary. docker-compose.dev.yml mounts
# an anonymous volume over /app/node_modules to keep this layer.
COPY package.json bun.lock ./
COPY apps/client/package.json apps/client/
COPY apps/server/package.json apps/server/
COPY packages/protocol/package.json packages/protocol/
COPY packages/game-engine/package.json packages/game-engine/
COPY packages/db/package.json packages/db/
COPY packages/i18n/package.json packages/i18n/
RUN bun install --frozen-lockfile

COPY . .

EXPOSE 3000 1420

CMD ["bun", "run", "dev"]
