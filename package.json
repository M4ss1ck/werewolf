{
  "name": "werewolf",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:client": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "start": "bun run --cwd apps/server start",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter \"*\" test",
    "format": "biome check --write .",
    "lint": "biome check .",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check": "bun run lint && bun run check:boundaries && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.2"
  }
}
