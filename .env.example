# Copy to .env and fill in. Where each value comes from is documented below.
# .env is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# PORT
# ---------------------------------------------------------------------------
# Port the server listens on. Pick anything free locally. In Coolify this is
# usually left at 3000 and the proxy maps 443 to it.
PORT=3000

# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN
# ---------------------------------------------------------------------------
# The database. Two ways to get one:
#
# Local development, no account needed. Point at a file and leave the token
# empty. This is what docker-compose.dev.yml does:
#
#   TURSO_DATABASE_URL=file:./data/werewolf.db
#   TURSO_AUTH_TOKEN=
#
# Hosted Turso, for staging and production:
#   1. Install the CLI:      curl -sSfL https://get.tur.so/install.sh | bash
#   2. Sign up / log in:     turso auth signup     (or: turso auth login)
#   3. Create a database:    turso db create werewolf
#   4. Get the URL:          turso db show werewolf --url
#                            -> libsql://werewolf-<org>.turso.io
#   5. Create a token:       turso db tokens create werewolf
#                            -> a long-lived token string
# The same values are visible in the Turso dashboard at https://app.turso.tech
# under your database's Overview tab.
TURSO_DATABASE_URL=file:./data/werewolf.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Any high-entropy string; generate one
# with:
#
#   openssl rand -base64 32
#
# Use a DIFFERENT value per environment. Changing it invalidates every existing
# session, which logs everyone out.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# BETTER_AUTH_URL
# ---------------------------------------------------------------------------
# The public origin the browser reaches the server on, with no trailing slash.
# It must match exactly what you register with Google, or sign-in fails with a
# redirect_uri_mismatch.
#   local:      http://localhost:3000
#   production: https://werewolf.example.com
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# ---------------------------------------------------------------------------
# Google OAuth credentials, from the Google Cloud console:
#
#   1. Go to https://console.cloud.google.com/
#   2. Create a project, or pick an existing one.
#   3. APIs & Services -> OAuth consent screen. Choose "External", give the app
#      a name and a support email. While the app is in "Testing" only accounts
#      you add under "Test users" can sign in, which is fine for development.
#   4. APIs & Services -> Credentials -> Create credentials
#      -> OAuth client ID -> Application type: Web application.
#   5. Under "Authorised redirect URIs" add one entry per environment, each
#      being your BETTER_AUTH_URL plus /api/auth/callback/google:
#
#        http://localhost:3000/api/auth/callback/google
#        https://werewolf.example.com/api/auth/callback/google
#
#   6. Create it. The dialog shows the client ID and client secret; the secret
#      is only shown once, so copy it now. Both remain available afterwards
#      under Credentials -> your OAuth client.
#
# The desktop and Android builds sign in through the same web flow against the
# same server, so they need no extra credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
