# Copy to .env and fill in. Where each value comes from is documented below.
# .env is gitignored; never commit real secrets.

# ---------------------------------------------------------------------------
# PORT
# ---------------------------------------------------------------------------
# Port the server listens on. Pick anything free locally. In Coolify this is
# usually left at 3000 and the proxy maps 443 to it.
PORT=3000

# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL / TURSO_AUTH_TOKEN
# ---------------------------------------------------------------------------
# The database. Two ways to get one:
#
# Local development, no account needed. Point at a file and leave the token
# empty. This is what docker-compose.dev.yml does:
#
#   TURSO_DATABASE_URL=file:./data/werewolf.db
#   TURSO_AUTH_TOKEN=
#
# Hosted Turso, for staging and production:
#   1. Install the CLI:      curl -sSfL https://get.tur.so/install.sh | bash
#   2. Sign up / log in:     turso auth signup     (or: turso auth login)
#   3. Create a database:    turso db create werewolf
#   4. Get the URL:          turso db show werewolf --url
#                            -> libsql://werewolf-<org>.turso.io
#   5. Create a token:       turso db tokens create werewolf
#                            -> a long-lived token string
# The same values are visible in the Turso dashboard at https://app.turso.tech
# under your database's Overview tab.
TURSO_DATABASE_URL=file:./data/werewolf.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Any high-entropy string; generate one
# with:
#
#   openssl rand -base64 32
#
# Use a DIFFERENT value per environment. Changing it invalidates every existing
# session, which logs everyone out.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# BETTER_AUTH_URL
# ---------------------------------------------------------------------------
# The public origin the browser reaches the server on, with no trailing slash.
# It must match exactly what you register with Google, or sign-in fails with a
# redirect_uri_mismatch.
#   local:      http://localhost:3000
#   production: https://werewolf.example.com
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# BETTER_AUTH_TRUSTED_ORIGINS
# ---------------------------------------------------------------------------
# Additional browser origins allowed to call Better Auth. Development uses a
# separate Vite origin, so trust it explicitly. Remove this localhost value in
# production unless the deployed frontend genuinely runs on another origin.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:1420

# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
# ---------------------------------------------------------------------------
# Google OAuth credentials, from the Google Cloud console:
#
#   1. Go to https://console.cloud.google.com/
#   2. Create a project, or pick an existing one.
#   3. APIs & Services -> OAuth consent screen. Choose "External", give the app
#      a name and a support email. While the app is in "Testing" only accounts
#      you add under "Test users" can sign in, which is fine for development.
#   4. APIs & Services -> Credentials -> Create credentials
#      -> OAuth client ID -> Application type: Web application.
#   5. Under "Authorised redirect URIs" add one entry per environment, each
#      being your BETTER_AUTH_URL plus /api/auth/callback/google:
#
#        http://localhost:3000/api/auth/callback/google
#        https://werewolf.example.com/api/auth/callback/google
#
#   6. Create it. The dialog shows the client ID and client secret; the secret
#      is only shown once, so copy it now. Both remain available afterwards
#      under Credentials -> your OAuth client.
#
# The desktop and Android builds sign in through the same web flow against the
# same server, so they need no extra credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# BOT_AI_* — LLM-driven bot players
# ---------------------------------------------------------------------------
# Only the provider lives here. Everything that varies per bot — model,
# temperature, output ceiling, timeout, personality — is defined per entry in
# the roster file (bots.json), so one deployment can run a cheap fast model for
# most seats and a slower one for a couple of them.
#
# The default provider is opencode-go, which speaks the OpenAI-compatible
# /chat/completions and /models API. Any other such endpoint works by changing
# the URL: OpenAI, OpenRouter, DeepSeek, Groq, or a local llama.cpp server.
#
# The key never leaves the server: it is not stored on a game row, not sent to
# a client, and not written to a log.
BOT_AI_PROVIDER=opencode-go
BOT_AI_BASE_URL=https://opencode.ai/zen/go/v1
BOT_AI_API_KEY=

# Where the selectable bots are defined. Each entry carries its own model and
# settings; see bots.json. A missing file is fine — the deployment then offers
# only the built-in "Dummy" bot, which plays random legal actions for free.
BOT_ROSTER_PATH=./bots.json

# With no BOT_AI_API_KEY every roster entry that names a model shows as
# unavailable in the lobby, and only the random bot can be seated. That is
# enough to exercise the engine end to end at no cost.

# Ceiling on model calls in flight across the whole process. Bots never block a
# phase, so queueing here costs a bot its turn at worst and protects the
# provider when many games run at once.
BOT_MAX_CONCURRENT_CALLS=4

# Artificial pause before a bot publishes, so it does not answer instantly.
# Set both to 0 in automated testing so bot games run as fast as possible.
BOT_MIN_DELAY_MS=1500
BOT_MAX_DELAY_MS=6000

# How many times one bot may speak in a single discussion phase. This is the
# hard cap on model calls per discussion: bots x turns. Voting and night
# phases always take exactly one call per bot.
BOT_DISCUSSION_TURNS=2

# How many recent visible events go into a prompt. Bounded on purpose: the
# match log must never grow into every request.
BOT_HISTORY_LIMIT=24

# Development only. Logs full prompts and raw model responses, which contain
# the deciding bot's own hidden role. Never enable in production.
BOT_LOG_PROMPTS=false
